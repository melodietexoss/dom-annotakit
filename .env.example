# dom-annotakit — environment template (copy to .env; never commit a real token)
# Ladder: shell env > .env > annotakit.config.json > runtime panel settings.

# GitHub PAT (classic, repo scope) — the sync token. Without it the kit runs
# the honest no-credential local mode.
# ANNOTAKIT_GH_TOKEN=<your-token-here>

# The GitHub repo (owner/name) for the issues mirror + the store branch.
# ANNOTAKIT_GH_REPO=owner/name

# Issues-mirror label (default: dom-annotakit).
# ANNOTAKIT_GH_LABELS=dom-annotakit

# Issues-mirror poll interval, seconds (default: 90).
# ANNOTAKIT_GH_POLL=90

# The GH Projects (v2) board URL for the spec mirror.
# ANNOTAKIT_PROJECT_URL=https://github.com/users/<you>/projects/<N>

# Store location override (default: the repo's git dir).
# ANNOTAKIT_STORE_PATH=/absolute/path/threads.db

# Standalone server port (default 4310).
# PORT=4310

# Captures folder override for the standalone server (default: start dir).
# DOM_AK_CAPTURES_DIR=/path/to/captures
