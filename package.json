{
  "name": "dom-annotakit",
  "version": "0.1.0",
  "private": true,
  "description": "AnnotaKit for SingleFile DOM snapshots: pin-comment review threads on captured pages. The storybook-annotakit engine (sqlite store, GitHub issue mirror, git-durability, agent digests) mounted on a standalone review app.",
  "license": "MIT",
  "author": "melodietexoss",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "dom-annotakit-server": "dist/standalone.cjs"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && vite build",
    "build:engine": "rm -rf dist && tsup",
    "build:app": "vite build",
    "typecheck": "tsc --noEmit",
    "serve": "node dist/standalone.cjs",
    "bake": "node scripts/bake-dom-annotakit.mjs",
    "release-check": "node scripts/release-check.mjs",
    "test:s6": "node scripts/s6-unit-test.mjs",
    "test:lattice": "node scripts/lattice-test.mjs",
    "test:static-store": "node scripts/static-store-test.mjs",
    "test:ghclient": "node scripts/ghclient-test.mjs",
    "test:ghsync": "node scripts/ghsync-fake.mjs",
    "test:api": "node scripts/api-test.mjs",
    "test:bake-selftest": "node scripts/bake-static-threads.mjs --selftest",
    "test:bake": "node scripts/bake-dom-annotakit.mjs --selftest",
    "test:store-robust": "node scripts/store-robust.mjs",
    "test:singlefile": "node scripts/singlefile-import-test.mjs",
    "test:drift": "node scripts/drift-check.mjs",
    "test:project-sync": "node scripts/project-sync-test.mjs",
    "test:spec-catalog": "node scripts/spec-catalog-test.mjs",
    "test:host-routes": "node scripts/host-routes-test.mjs",
    "test:all": "npm run typecheck && npm run test:s6 && npm run test:lattice && npm run test:static-store && npm run test:ghclient && npm run test:ghsync && npm run test:api && npm run test:bake-selftest && npm run test:store-robust && npm run test:singlefile && npm run test:project-sync && npm run test:spec-catalog && npm run test:host-routes && npm run test:drift"
  },
  "dependencies": {
    "@medv/finder": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
